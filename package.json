{
  "name": "quiz-rpg",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev:student": "pnpm -C apps/student dev",
